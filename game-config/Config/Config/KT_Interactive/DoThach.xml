<?xml version="1.0" encoding="utf-8"?>
<DoThach>
    <!--Spinner
        ID: id của Spinner bắt đầu từ 0
        name: Tên Spinner hiển thị ở trên tab bên tay trái trong giao diện
        limitKNB: Giới hạn số lượt quay bằng KNB trong ngày
        hint: Đoạn text mô tả ngắn gọn về Spinner, hiển thị ở trên cùng giao diện-->
    <Spinner id="0" name= "Đổ thạch thường" limitKNB="50" active="true"
                hint="Đổ thạch thường ngẫu nhiên nhận được:\n- Mảnh vỡ bảo thạch\n- Bảo thạch phổ thông và bảo thạch đặc thù(Ngẫu nhiên từ cấp 1 đến cấp 3)">
        <Fees>
            <!--Fees
            id: id của tiền trong game
            amount: số lượng tiền
            spinTimes: số lần quay tương ứng với mức phí
            -->
            <Fee id="14249" amount="1" spinTimes="1"/>
            <Fee id="14249" amount="10" spinTimes="10"/>
            <Fee id="2" amount="1800" spinTimes="10"/>
        </Fees>

        <Rates>
            <!-- Rate
            item: id của vật phẩm
            amount: số lượng vật phẩm nhận được khi trúng 
            weight: trọng số để tính xác suất trúng, số càng lớn xác suất càng cao
                    ở phần này đang nhân tỉ lệ 100 lần so với tỉ lệ thực tế để tránh số lẻ
            fakeRate: tỉ lệ hiện thị cho người chơi, tổng tỉ lệ của tất cả vật phẩm phải bằng 100%
            -->
            <!-- Common -->
            <Rate item="14241" amount="1" weight="2500" fakeRate="22.00"/>
            <Rate item="14241" amount="2" weight="1500" fakeRate="13.00"/>
            <Rate item="14201" amount="1" weight="2500" fakeRate="22.00"/>
            <Rate item="14211" amount="1" weight="1500" fakeRate="13.00"/>
            <!-- Rare -->
            <Rate item="14241" amount="3" weight="700" fakeRate="10.00"/>
            <Rate item="14202" amount="1" weight="650" fakeRate="8.50"/>
            <Rate item="14212" amount="1" weight="350" fakeRate="6.50"/>
            <!-- Super Rare -->
            <Rate item="14203" amount="1" weight="200" fakeRate="3.00"/>
            <Rate item="14213" amount="1" weight="100" fakeRate="2.00"/>
        </Rates>
        <Pitys>    
            <!-- Pity
            level: cấp độ Pity, bắt đầu từ 1
            text: đoạn text mô tả Pity, hiển thị trong giao diện (số lượt quay sẽ được thay thế vào dấu ?)
            milestone: số lượt quay cần đạt được để kích hoạt Pity
            resetItem: danh sách itemID của các vật phẩm khi trúng cũng sẽ reset lại mốc Pity, cách nhau bởi dấu phẩy(không tính các vật phẩm trong mục guaranteed)
            guaranteed: danh sách itemID của các vật phẩm được bảo đảm trúng khi đạt mốc Pity, cách nhau bởi dấu phẩy
            -->
            <Pity level="1" text="Đổ thạch thường &lt;color=#FF181A&gt;?&lt;/color&gt; lần chắc chắn nhận &lt;color=#13FF27&gt;1 bảo thạch cấp 2&lt;/color&gt;" milestone="10" resetItem="" guaranteed="14202,14212"/>
            <Pity level="2" text="Đổ thạch thường &lt;color=#FF181A&gt;?&lt;/color&gt; lần chắc chắn nhận &lt;color=#13FF27&gt;1 bảo thạch cấp 3 trở lên&lt;/color&gt;" milestone="30" resetItem="" guaranteed="14203,14213"/>
