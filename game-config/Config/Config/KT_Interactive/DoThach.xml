            <Pity level="3" text="Đổ thạch thần bí &lt;color=#FF181A&gt;?&lt;/color&gt; lần chắc chắn nhận &lt;color=#13FF27&gt;1 bảo thạch Kĩ Năng, Trang Bị&lt;/color&gt;" milestone="100" resetItem="14205,14215" guaranteed="14221,14231"/>
