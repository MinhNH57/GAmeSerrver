<!-- Hướng dẫn cấu hình BattlePass
Cấu hình Level BP

<Level ID="[number]"               
ID cấp độ, không trùng lặp, bắt đầu từ 1, tăng dần ExpRequired="[number]"      
Kinh nghiệm cần để lên cấp độ này (cấp độ 1 cần 0 kinh nghiệm)
>
    <FreeReward ItemID="[number]"       
    ID vật phẩm nhận được ở cấp độ này (nếu có) Number="[number]"       
    Số lượng vật phẩm nhận được ở cấp độ này (nếu có)        
    />
    <EliteReward ItemID="[number]"       
    ID vật phẩm nhận được ở cấp độ này nếu là Elite (nếu có) Number="[number]"       
    Số lượng vật phẩm nhận được ở cấp độ này nếu là Elite (nếu có)        
    />    
</Level>

Cấu hình task

  <Task ID="[number]"         ID nhiệm vụ, không trùng lặp Name="[string]"             Tên nhiệm vụ Type="[0/1]"                Loại nhiệm vụ, 0: Làm 1 lần xong luôn, 1: Làm nhiều lần (cần NumberItem) NumberItem="[number]"       Số lượng cần làm để hoàn thành nhiệm vụ IndexRepeat="[number]"      Số lần lặp lại nhiệm vụ, 0: hằng ngày, 1: hằng tuần, 2: mùa giải EventType="[number]"        Loại sự kiện Param="[number/-1]"         Tham số sự kiện, -1: không có tham số, >0: có tham số, thường là ID của vật phẩm, quái vật, nhiệm vụ Exp="[number]"              Điểm Battle Pass nhận được khi hoàn thành nhiệm vụ
  </Task>

Cấu hình gói BP
  <Bundle ID="[number]"          ID gói BP, không trùng lặp (1: Cao Cấp, 2: Siêu Cấp) Title="[string]"              Tên hiển thị của gói BP Price="[decimal]"            Giá tiền thật (USD) Currency="[string]"          Đơn vị tiền tệ (USD, VND, ...)
  >
      <InstantReward ItemID="[number]"      ID vật phẩm nhận ngay khi mua gói Number="[number]"       Số lượng vật phẩm nhận được
      />
      <ExclusiveReward ItemID="[number]"    ID vật phẩm độc quyền của BP Number="[number]"     Số lượng vật phẩm nhận được
      />
      <BundleExclusiveReward ItemID="[number]"    ID vật phẩm độc quyền của gói Siêu Cấp Number="[number]"      Số lượng vật phẩm nhận được
      />
  </Bundle>

Cấu hình phần thưởng nhận được khi đầy cấp

  <BonusChest ExpRequired="[number]"     Số điểm kinh nghiệm cần để nhận thưởng
  >
      <Reward ItemID="[number]"          ID vật phẩm trong Rương Phần Thưởng Number="[number]"          Số lượng vật phẩm nhận được
      />
  </BonusChest>
-->

